{
  "name": "pi-claude-code",
  "version": "0.1.0",
  "description": "Claude Code experience for the pi coding agent: ported system prompt, Claude-Code-format permissions, .claude/ compatibility, ToolSearch-style deferred tools, and system-reminder steering",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "extensions/claude-compat/index.ts",
      "extensions/system-reminder/index.ts",
      "extensions/tool-search/index.ts",
      "extensions/permissions/index.ts",
      "extensions/ask-user/index.ts",
      "extensions/subagents/index.ts",
      "extensions/todo/index.ts",
      "extensions/plan-mode/index.ts",
      "extensions/notebook/index.ts",
      "extensions/system-prompt/index.ts"
    ],
    "skills": [
      "./node_modules/pi-ask-user/skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pi-ask-user": "^0.14.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  }
}
