{
	"name": "one-code-extension",
	"version": "0.7.0",
	"description": "One Code as a pi package — the Claude Code experience on your own pi install: ported system prompt, Claude-Code-format permissions, .claude/ compatibility, ToolSearch-style deferred tools, and system-reminder steering. For the bundled app, install `@one-ai/one-code` instead.",
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"claude-code",
		"coding-agent",
		"mcp",
		"agent"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IsuruMaduranga/one-code.git"
	},
	"homepage": "https://github.com/IsuruMaduranga/one-code#readme",
	"bugs": {
		"url": "https://github.com/IsuruMaduranga/one-code/issues"
	},
	"type": "module",
	"pi": {
		"extensions": [
			"extensions/ui/branding/index.ts",
			"extensions/commands/claude-compat/index.ts",
			"extensions/request/kept-thinking/index.ts",
			"extensions/request/ledger/index.ts",
			"extensions/context/context-budget/index.ts",
			"extensions/request/system-reminder/index.ts",
			"extensions/context/claude-context/index.ts",
			"extensions/request/tool-call-corruption/index.ts",
			"extensions/safety/hooks/index.ts",
			"extensions/request/tool-search/index.ts",
			"extensions/tools/search-tools/index.ts",
			"extensions/tools/tool-style/index.ts",
			"extensions/tools/plugins/index.ts",
			"extensions/safety/worktree/index.ts",
			"extensions/safety/file-tracker/index.ts",
			"extensions/context/memory/index.ts",
			"extensions/safety/permissions/index.ts",
			"extensions/tools/ask-user/index.ts",
			"extensions/tools/skill/index.ts",
			"extensions/tools/background/index.ts",
			"extensions/tools/bash/index.ts",
			"extensions/tools/powershell/index.ts",
			"extensions/agents/subagents/index.ts",
			"extensions/agents/workflow/index.ts",
			"extensions/ui/effort/index.ts",
			"extensions/ui/spinner/index.ts",
			"extensions/ui/model-default/index.ts",
			"extensions/ui/newer-model/index.ts",
			"extensions/ui/footer/index.ts",
			"extensions/ui/turn-duration/index.ts",
			"extensions/ui/interrupted/index.ts",
			"extensions/ui/send-now/index.ts",
			"extensions/agents/recap/index.ts",
			"extensions/agents/btw/index.ts",
			"extensions/agents/session-title/index.ts",
			"extensions/commands/exit/index.ts",
			"extensions/commands/init/index.ts",
			"extensions/commands/clear/index.ts",
			"extensions/tools/tasks/index.ts",
			"extensions/safety/plan-mode/index.ts",
			"extensions/tools/notebook/index.ts",
			"extensions/tools/artifacts/index.ts",
			"extensions/tools/web/index.ts",
			"extensions/tools/web-fetch/index.ts",
			"extensions/tools/lsp/index.ts",
			"extensions/tools/mcp/index.ts",
			"extensions/commands/doctor/index.ts",
			"extensions/request/context-management/index.ts",
			"extensions/context/compaction/index.ts",
			"extensions/context/idle-compact/index.ts",
			"extensions/request/ledger/wire.ts",
			"extensions/request/cache-marks/index.ts",
			"extensions/request/system-prompt/index.ts",
			"profile/extensions/*/index.ts",
			"extensions/safety/secret-values/index.ts"
		],
		"themes": [
			"./profile/themes"
		]
	},
	"files": [
		"extensions/",
		"profile/",
		"!profile/test/",
		"types/",
		"README.md",
		"LICENSE",
		"docs/guide/"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"gen:model-catalog": "node scripts/gen-model-catalog.mjs",
		"sync:app-readme": "node scripts/app-readme.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@mozilla/readability": "^0.6.0",
		"acorn": "^8.18.0",
		"ignore": "^7.0.8",
		"linkedom": "^0.18.13",
		"marked": "^18.0.11",
		"pi-web-search": "^1.5.0",
		"turndown": "^7.2.4",
		"web-tree-sitter": "^0.27.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.5.0",
		"@earendil-works/pi-ai": "^1.5.0",
		"@earendil-works/pi-coding-agent": "^1.5.0",
		"@types/node": "^26.1.2",
		"@types/turndown": "^5.0.6",
		"typebox": "^1.3.7",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"typebox": "*"
	}
}
