{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "pi-web-search/src/index.ts": [
        "./types/community-packages.d.ts"
      ]
    }
  },
  "include": [
    "extensions/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
